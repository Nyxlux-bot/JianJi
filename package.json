{
  "name": "liuyao-app",
  "version": "1.8.3",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_REDIRECT_PAGE=1 expo start --go",
    "android": "npm run start -- --android",
    "ios": "npm run start -- --ios",
    "web": "expo start --web",
    "release:patch": "node scripts/release-version.js patch",
    "release:minor": "node scripts/release-version.js minor",
    "release:major": "node scripts/release-version.js major",
    "release:beta": "node scripts/release-version.js beta",
    "setup:hooks": "git config core.hooksPath .githooks",
    "guard:no-tests": "sh scripts/guard-no-test-files.sh --staged",
    "check:motion": "node scripts/check-motion.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "iztro": "^2.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tyme4ts": "^1.5.6"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~7.0.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "overrides": {
    "node-forge": "1.4.3",
    "markdown-it": "15.0.3",
    "postcss": "8.5.30"
  }
}
